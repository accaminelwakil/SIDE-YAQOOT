@echo off
chcp 65001 > nul
set PYTHONIOENCODING=utf-8
title منظومة عيادات سيدي ياقوت التخصصية - سيرفر الموبايل والشبكة
cd /d "%~dp0"
echo ===================================================================
echo   جاري تشغيل خادم منظومة عيادات سيدي ياقوت التخصصية...
echo ===================================================================
python server.py
if %errorlevel% neq 0 (
    echo.
    echo حدث خطأ أثناء تشغيل السيرفر بواسطة Python. جاري فتح البرنامج محلياً في المتصفح...
    start index.html
    pause
)
