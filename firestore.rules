rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sidi_yaqout_erp/{document=**} {
      function canUseApp() {
        return request.auth != null && request.auth.token.passwordChangeRequired != true;
      }
      function canView(screen) {
        return canUseApp() && (
          request.auth.token.role == 'admin' ||
          (request.auth.token.screenAccess != null &&
           request.auth.token.screenAccess[screen] in ['view', 'edit'])
        );
      }
      function canViewSensitive(screen) {
        return canUseApp() && request.auth.token.role != 'employee' && (
          request.auth.token.role == 'admin' ||
          (request.auth.token.screenAccess != null &&
           request.auth.token.screenAccess[screen] in ['view', 'edit'])
        );
      }
      function canEdit(screen) {
        return canUseApp() && (
          request.auth.token.role == 'admin' ||
          (request.auth.token.screenAccess != null &&
           request.auth.token.screenAccess[screen] == 'edit')
        );
      }

      allow read, write: if false;
      allow read: if document == 'employees' &&
        (
          canViewSensitive('screen-employees') ||
          canViewSensitive('screen-attendance') ||
          canViewSensitive('screen-single-sarki') ||
          canViewSensitive('screen-bulk-payslips') ||
          canViewSensitive('screen-payroll-summary') ||
          canViewSensitive('screen-payroll-delivery') ||
          canViewSensitive('screen-emp-general-report') ||
          canViewSensitive('screen-totals-report') ||
          canViewSensitive('screen-punches-payroll') ||
          canViewSensitive('screen-attendance-comparison')
        );
      allow write: if false;
      allow read: if document == 'attendance' && (
        canViewSensitive('screen-attendance') ||
        canViewSensitive('screen-single-sarki') ||
        canViewSensitive('screen-bulk-payslips') ||
        canViewSensitive('screen-payroll-summary') ||
        canViewSensitive('screen-emp-general-report') ||
        canViewSensitive('screen-totals-report') ||
        canViewSensitive('screen-punches-payroll') ||
        canViewSensitive('screen-attendance-comparison')
      );
      allow write: if false;
      allow read: if document == 'salaryAdjustments' && (
        canViewSensitive('screen-salary-adjustments') ||
        canViewSensitive('screen-single-sarki') ||
        canViewSensitive('screen-bulk-payslips') ||
        canViewSensitive('screen-payroll-summary') ||
        canViewSensitive('screen-payroll-delivery') ||
        canViewSensitive('screen-emp-general-report') ||
        canViewSensitive('screen-totals-report')
      );
      allow write: if false;
      allow read: if document == 'payrollDelivery' && canView('screen-payroll-delivery');
      allow read: if document == 'payrollCycles' && canView('screen-payroll-summary');
      allow read: if document == 'departments' &&
        (canView('screen-employees') || canView('screen-leaves-permissions'));
      allow write: if false;
      allow read: if document == 'shifts' && (
        canViewSensitive('screen-attendance') ||
        canViewSensitive('screen-single-sarki') ||
        canViewSensitive('screen-bulk-payslips') ||
        canViewSensitive('screen-payroll-summary')
      );
      allow read: if document == 'officialHolidays' && (
        canView('screen-attendance') ||
        canView('screen-employee-sarki') ||
        canView('screen-single-sarki') ||
        canView('screen-bulk-payslips') ||
        canView('screen-payroll-summary') ||
        canView('screen-punches-payroll')
      );
      allow read: if document == 'users' && canUseApp() && request.auth.token.role == 'admin';
      allow read, write: if document == 'metadata' && canUseApp() && request.auth.token.role == 'admin';
      allow write: if document == '_system_ping' && canUseApp() && request.auth.token.role == 'admin';
    }
  }
}
